  @@schema("celesnity_app")
}

enum FirmwareDeploymentStatus {
  QUEUED
  DISPATCHED
  ACCEPTED
  DOWNLOADING
  VERIFYING
  INSTALLING
  REBOOTING
  SUCCEEDED
  FAILED
  ROLLED_BACK
  CANCELLED

