  organization                   Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gateway                        Device?                     @relation("GatewaySensors", fields: [gatewayId], references: [id], onDelete: Restrict)
  sensors                        Device[]                    @relation("GatewaySensors")
