model DataWorkflowWatchSourceCheckpoint {
  id               String                  @id @db.Uuid
  organizationId   String                  @default(dbgenerated()) @map("organization_id") @db.Uuid
  watchSourceId    String                  @map("watch_source_id") @db.Uuid
  schemaName       String                  @map("schema_name") @db.VarChar(255)
  tableName        String                  @map("table_name") @db.VarChar(255)
  opaqueCheckpoint String                  @map("opaque_checkpoint") @db.Text
  revision         Int                     @default(1)
  establishedAt    DateTime                @map("established_at") @db.Timestamptz(6)
  advancedAt       DateTime                @map("advanced_at") @db.Timestamptz(6)
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  watchSource      DataWorkflowWatchSource @relation(fields: [watchSourceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([watchSourceId, schemaName, tableName, organizationId])
  @@index([organizationId, watchSourceId])
  @@map("data_workflow_watch_source_checkpoints")
  @@schema("celesnity_app")
}

model DataWorkflowWatchSourceCdcWindow {
  id             String                              @id @db.Uuid
  organizationId String                              @default(dbgenerated()) @map("organization_id") @db.Uuid
  watchSourceId  String                              @map("watch_source_id") @db.Uuid
  openedAt       DateTime                            @map("opened_at") @db.Timestamptz(6)
  closesAt       DateTime                            @map("closes_at") @db.Timestamptz(6)
  status         String                              @db.VarChar(16)
  eventCount     Int                                 @default(0) @map("event_count")
  createdAt      DateTime                            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization                        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  watchSource    DataWorkflowWatchSource             @relation(fields: [watchSourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  relations      DataWorkflowWatchSourceCdcRelation[]
  events         DataWorkflowWatchSourceCdcEvent[]

  @@unique([id, organizationId])
  @@index([status, closesAt, id])
  @@index([organizationId, watchSourceId, status, closesAt])
  @@map("data_workflow_watch_source_cdc_windows")
  @@schema("celesnity_app")
}

model DataWorkflowWatchSourceCdcRelation {
  id             String                              @id @db.Uuid
  organizationId String                              @default(dbgenerated()) @map("organization_id") @db.Uuid
  windowId       String                              @map("window_id") @db.Uuid
  schemaName     String                              @map("schema_name") @db.VarChar(255)
  tableName      String                              @map("table_name") @db.VarChar(255)
  changeTypes    String[]                            @map("change_types")
  eventCount     Int                                 @default(0) @map("event_count")
  firstEventAt   DateTime                            @map("first_event_at") @db.Timestamptz(6)
  lastEventAt    DateTime                            @map("last_event_at") @db.Timestamptz(6)
  organization   Organization                        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  window         DataWorkflowWatchSourceCdcWindow    @relation(fields: [windowId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([windowId, schemaName, tableName, organizationId])
  @@index([organizationId, windowId])
  @@map("data_workflow_watch_source_cdc_relations")
  @@schema("celesnity_app")
}

model DataWorkflowWatchSourceCdcEvent {
  id                   String                           @id @db.Uuid
  organizationId       String                           @default(dbgenerated()) @map("organization_id") @db.Uuid
  windowId             String                           @map("window_id") @db.Uuid
  watchSourceId        String                           @map("watch_source_id") @db.Uuid
  connectorId          String                           @map("connector_id") @db.VarChar(255)
  topic                String                           @db.VarChar(512)
  partition            Int
  positionFingerprint  String                           @map("position_fingerprint") @db.VarChar(255)
  schemaName           String                           @map("schema_name") @db.VarChar(255)
  tableName            String                           @map("table_name") @db.VarChar(255)
  operation            String                           @db.VarChar(16)
  committedAt          DateTime                         @map("committed_at") @db.Timestamptz(6)
  createdAt            DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization         Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  window               DataWorkflowWatchSourceCdcWindow @relation(fields: [windowId, organizationId], references: [id, organizationId], onDelete: Restrict)
  watchSource          DataWorkflowWatchSource             @relation(fields: [watchSourceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([watchSourceId, connectorId, topic, partition, positionFingerprint, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId, windowId])
  @@map("data_workflow_watch_source_cdc_events")
  @@schema("celesnity_app")
}

model DataWorkflowWatchSourceCdcCheckpoint {
  id                  String       @id @db.Uuid
  organizationId      String       @default(dbgenerated()) @map("organization_id") @db.Uuid
  connectorId         String       @map("connector_id") @db.VarChar(255)
  topic               String       @db.VarChar(512)
  partition           Int
  positionFingerprint String       @map("position_fingerprint") @db.VarChar(255)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([connectorId, topic, partition, organizationId])
  @@unique([id, organizationId])
  @@map("data_workflow_watch_source_cdc_checkpoints")
  @@schema("celesnity_app")
}

model DataWorkflowWatchSourceNotificationBatch {
  id             String                                @id @db.Uuid
  organizationId String                                @default(dbgenerated()) @map("organization_id") @db.Uuid
  watchSourceId  String                                @map("watch_source_id") @db.Uuid
  captureKey     String                                @map("capture_key") @db.VarChar(512)
  capturedAt     DateTime                              @map("captured_at") @db.Timestamptz(6)
  organization   Organization                          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  watchSource    DataWorkflowWatchSource               @relation(fields: [watchSourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  notifications  DataWorkflowWatchSourceNotification[]

  @@unique([id, organizationId])
  @@unique([watchSourceId, captureKey, organizationId])
  @@index([organizationId, capturedAt])
  @@map("data_workflow_watch_source_notification_batches")
  @@schema("celesnity_app")
}

model DataWorkflowWatchSourceNotification {
  id                    String                                      @id @db.Uuid
  organizationId        String                                      @default(dbgenerated()) @map("organization_id") @db.Uuid
  watchSourceId         String                                      @map("watch_source_id") @db.Uuid
  batchId               String                                      @map("batch_id") @db.Uuid
  schemaName            String                                      @map("schema_name") @db.VarChar(255)
  tableName             String                                      @map("table_name") @db.VarChar(255)
  changeTypes           String[]                                    @map("change_types")
  checkpointFingerprint String                                      @map("checkpoint_fingerprint") @db.VarChar(255)
  idempotencyKey        String                                      @map("idempotency_key") @db.VarChar(768)
  adapterKey            String                                      @map("adapter_key") @db.VarChar(80)
  adapterVersion        String                                      @map("adapter_version") @db.VarChar(80)
  capturedAt            DateTime                                    @map("captured_at") @db.Timestamptz(6)
  organization          Organization                                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  watchSource           DataWorkflowWatchSource                     @relation(fields: [watchSourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  batch                 DataWorkflowWatchSourceNotificationBatch    @relation(fields: [batchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignments           DataWorkflowWatchSourceDeliveryAssignment[]

  @@unique([id, organizationId])
  @@unique([watchSourceId, idempotencyKey, organizationId])
  @@index([organizationId, watchSourceId, capturedAt])
  @@map("data_workflow_watch_source_notifications")
  @@schema("celesnity_app")
}

model DataWorkflowWatchSourceDeliveryAssignment {
  id                String                              @id @db.Uuid
  organizationId    String                              @default(dbgenerated()) @map("organization_id") @db.Uuid
  subscriptionId    String                              @map("subscription_id") @db.Uuid
  notificationId    String                              @map("notification_id") @db.Uuid
  workflowId        String                              @map("workflow_id") @db.Uuid
  workflowVersionId String                              @map("workflow_version_id") @db.Uuid
  workflowRunId     String?                             @map("workflow_run_id") @db.Uuid
  status            String                              @db.VarChar(16)
  revision          Int                                 @default(1)
  leaseOwner        String?                             @map("lease_owner") @db.VarChar(160)
  leaseToken        String?                             @map("lease_token") @db.Uuid
  leaseExpiresAt    DateTime?                           @map("lease_expires_at") @db.Timestamptz(6)
  deliveredAt       DateTime?                           @map("delivered_at") @db.Timestamptz(6)
  createdAt         DateTime                            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization                        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription      DataWorkflowWatchSourceSubscription @relation(fields: [subscriptionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  notification      DataWorkflowWatchSourceNotification @relation(fields: [notificationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workflowVersion   DataWorkflowVersion                 @relation(fields: [workflowId, workflowVersionId, organizationId], references: [workflowId, id, organizationId], onDelete: Restrict)
  workflowRun       DataWorkflowRun?                    @relation("WatchSourceDeliveryRun", fields: [workflowRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([subscriptionId, notificationId, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([status, workflowRunId, createdAt], map: "data_workflow_watch_assignments_run_idx")
  @@index([status, leaseExpiresAt, createdAt, id], map: "data_workflow_watch_assignments_global_claim_idx")
  @@map("data_workflow_watch_source_delivery_assignments")
  @@schema("celesnity_app")
}

model AutomationWorkflow {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  name             String    @db.VarChar(255)
  status           String    @default("draft") @db.VarChar(16)
  triggerType      String    @map("trigger_type") @db.VarChar(16)
  eventTopic       String?   @map("event_topic") @db.VarChar(255)
  scheduleCron     String?   @map("schedule_cron") @db.VarChar(255)
  scheduleTimezone String?   @map("schedule_timezone") @db.VarChar(64)
  nextRunAt        DateTime? @map("next_run_at") @db.Timestamptz(6)
  triggerFields    Json      @default("[]") @map("trigger_fields")
  createdBy        String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        AutomationWorkflowStep[]
  runs         AutomationWorkflowRun[]

  @@unique([organizationId, name])
  @@index([organizationId, eventTopic])
  @@index([triggerType, nextRunAt])
  @@map("automation_workflows")
  @@schema("celesnity_app")
}

model AutomationWorkflowStep {
  id            String  @id @db.Uuid
  workflowId    String  @map("workflow_id") @db.Uuid
  order         Int
  agentId       String  @map("agent_id") @db.VarChar(255)
  inputTemplate Json    @map("input_template")
  systemPrompt  String? @map("system_prompt")

  workflow AutomationWorkflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepRuns AutomationWorkflowStepRun[]

  @@unique([workflowId, order])
  @@map("automation_workflow_steps")
  @@schema("celesnity_app")
}

model AutomationWorkflowRun {
  id             String    @id @db.Uuid
  workflowId     String    @map("workflow_id") @db.Uuid
  triggeredBy    String    @map("triggered_by") @db.VarChar(16)
  status         String    @db.VarChar(16)
  triggerPayload Json      @map("trigger_payload")
  startedAt      DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)

  workflow AutomationWorkflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepRuns AutomationWorkflowStepRun[]

  @@index([workflowId, startedAt])
  @@map("automation_workflow_runs")
  @@schema("celesnity_app")
}

model AutomationWorkflowStepRun {
  id         String    @id @db.Uuid
  runId      String    @map("run_id") @db.Uuid
  stepId     String    @map("step_id") @db.Uuid
  agentRunId String?   @map("agent_run_id") @db.Uuid
  status     String    @default("queued") @db.VarChar(16)
  output     String?   @db.Text
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  run  AutomationWorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  step AutomationWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("automation_workflow_step_runs")
  @@schema("celesnity_app")
}

model TutorialDefinition {
  id                  String             @id @db.VarChar(120)
  metadata            Json
  steps               Json
  requiredFeatures    String[]           @default([]) @map("required_features")
  prerequisites       Json
  contextRequirements Json               @map("context_requirements")
  revision            Int                @default(1)
  publishedAt         DateTime           @default(now()) @map("published_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  progress            TutorialProgress[]

  @@map("tutorial_definitions")
  @@schema("celesnity_app")
}

model TutorialProgress {
  id                String                 @id @db.Uuid
  organizationId    String                 @map("organization_id") @db.Uuid
  identityId        String                 @map("identity_id") @db.Uuid
  tutorialId        String                 @map("tutorial_id") @db.VarChar(120)
  status            TutorialProgressStatus
  currentStepId     String                 @map("current_step_id") @db.VarChar(120)
  completedStepIds  String[]               @default([]) @map("completed_step_ids")
  contextSelections Json                   @map("context_selections")
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity          UserIdentity           @relation(fields: [identityId], references: [id], onDelete: Cascade)
  tutorial          TutorialDefinition     @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  @@unique([organizationId, identityId, tutorialId])
  @@index([organizationId, identityId, status])
  @@map("tutorial_progress")
  @@schema("celesnity_app")
}

model TutorialOnboardingDecision {
  id             String                          @id @db.Uuid
  organizationId String                          @map("organization_id") @db.Uuid
  identityId     String                          @map("identity_id") @db.Uuid
  decision       TutorialOnboardingDecisionValue
  createdAt      DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity       UserIdentity                    @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, identityId])
  @@map("tutorial_onboarding_decisions")
  @@schema("celesnity_app")
}

model TutorialCompletion {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  identityId     String       @map("identity_id") @db.Uuid
  runId          String       @map("run_id") @db.VarChar(160)
  completedAt    DateTime     @default(now()) @map("completed_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity       UserIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, identityId, runId])
  @@index([organizationId, identityId, completedAt])
  @@map("tutorial_completions")
  @@schema("celesnity_app")
}
