enum MetadataCrawlerScopeType {
  DATABASE
  SCHEMA

  @@schema("celesnity_app")
}

enum MetadataCrawlerScopeStatus {
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("celesnity_app")
}

enum CatalogNamespaceType {
  DATABASE
  SCHEMA

  @@schema("celesnity_app")
}

enum CatalogRelationType {
  TABLE
  PARTITIONED_TABLE
  VIEW
  MATERIALIZED_VIEW
  FOREIGN_TABLE

  @@schema("celesnity_app")
}

enum CatalogConstraintType {
  PRIMARY_KEY
  FOREIGN_KEY
  UNIQUE
  CHECK

  @@schema("celesnity_app")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDING
  CLOSED

  @@schema("celesnity_app")
}

enum IdentityStatus {
  ACTIVE
  SUSPENDED
  TERMINATED

  @@schema("celesnity_app")
}

enum OrganizationRole {
  PLATFORM_ADMIN
  SUPPORT
  ORG_OWNER
  ORG_ADMIN
  DATA_ENGINEER
  ANALYST
  VIEWER
  AUDITOR
  SERVICE_ACCOUNT

  @@schema("celesnity_app")
}

enum MembershipStatus {
  ACTIVE
  REVOKED

  @@schema("celesnity_app")
}

enum TutorialProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED

  @@schema("celesnity_app")
}

enum TutorialOnboardingDecisionValue {
  ACCEPTED
  DISMISSED

  @@schema("celesnity_app")
}

enum OauthConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
  REVOKED

  @@schema("celesnity_app")
}

enum CatalogResourceType {
  CATALOG
  DATABASE
  SCHEMA
  TABLE
  COLUMN

  @@schema("celesnity_app")
}

enum CatalogPermission {
  DISCOVER
  DESCRIBE
  PREVIEW
  SELECT
  INSERT
  UPDATE
  DELETE
  EXECUTE
  ALTER
  GRANT
  OWN

  @@schema("celesnity_app")
}

enum PolicyEffect {
  ALLOW
  DENY

  @@schema("celesnity_app")
}

model Organization {
  id                                         String                                      @id @db.Uuid
  slug                                       String                                      @unique @db.VarChar(80)
  displayName                                String                                      @map("display_name") @db.VarChar(160)
  homeRegion                                 String                                      @map("home_region") @db.VarChar(40)
  status                                     OrganizationStatus                          @default(ACTIVE)
  verifiedDomains                            String[]                                    @default([]) @map("verified_domains")
  identityTenantId                           String?                                     @unique @map("identity_tenant_id") @db.VarChar(128)
  mfaRequired                                Boolean                                     @default(false) @map("mfa_required")
  createdAt                                  DateTime                                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                  DateTime                                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships                                OrganizationMembership[]
  serviceIdentities                            OrganizationServiceIdentity[]
  documents                                  Document[]
  invitations                                OrganizationInvitation[]
  auditEvents                                AuditEvent[]
  tenants                                    Tenant[]
  databaseServices                           DatabaseService[]
  databaseServiceMemberships                  DatabaseServiceMembership[]
  cdcConnectionProfiles                     DatabaseServiceCdcConnectionProfile[]
  pipelines                                  Pipeline[]
  scripts                                    Script[]
  executions                                 Execution[]
  sqlExecutions                              SqlExecution[]
  outboxEvents                               OutboxEvent[]
  metadataCrawlers                           MetadataCrawler[]
  crawlerAssignments                         DatabaseMetadataCrawler[]
  messageBlocks                              MessageBlock[]
  groups                                     AuthorizationGroup[]
  catalogGrants                              CatalogAccessGrant[]
  namespaceDescriptions                      CatalogNamespaceDescription[]
  agentRooms                                 AgentRoomBinding[]
  agentRunScopes                             AgentRunScope[]
  automationWorkflows                        AutomationWorkflow[]
  chartCollections                           ChartCollection[]
  charts                                     Chart[]
  dashboards                                 Dashboard[]
  devices                                    Device[]
  measurementPoints                          MeasurementPoint[]
  deviceLifecycleTransitions                 DeviceLifecycleTransition[]
  deviceProvisioningAttempts                 DeviceProvisioningAttempt[]
  firmwareReleases                           FirmwareRelease[]
  firmwareDeployments                        FirmwareDeployment[]
  firmwareCampaigns                          FirmwareCampaign[]
  firmwareCampaignTargets                    FirmwareCampaignTarget[]
  deviceAlerts                               DeviceAlert[]
  deviceConfigurations                       DeviceConfiguration[]
  deviceConfigurationTemplates               DeviceConfigurationTemplate[]
  deviceLogs                                 DeviceLog[]
  plantSites                                 PlantSite[]
  plantModelVersions                         PlantModelVersion[]
  plantDashboardAssociations                 PlantDashboardAssociation[]
  dataWorkflows                              DataWorkflow[]
  dataWorkflowVersions                       DataWorkflowVersion[]
  dataWorkflowSchedules                      DataWorkflowSchedule[]
  dataWorkflowRuns                           DataWorkflowRun[]
  dataWorkflowNodeAttempts                   DataWorkflowNodeAttempt[]
  dataWorkflowRetryAcknowledgements          DataWorkflowRetryAcknowledgement[]
  dataWorkflowEdgeStates                     DataWorkflowEdgeState[]
  dataWorkflowWatchSources                   DataWorkflowWatchSource[]
  dataWorkflowWatchSourceSubscriptions       DataWorkflowWatchSourceSubscription[]
  dataWorkflowWatchSourceCheckpoints         DataWorkflowWatchSourceCheckpoint[]
  dataWorkflowWatchSourceCdcWindows          DataWorkflowWatchSourceCdcWindow[]
  dataWorkflowWatchSourceCdcRelations        DataWorkflowWatchSourceCdcRelation[]
  dataWorkflowWatchSourceCdcEvents           DataWorkflowWatchSourceCdcEvent[]
  dataWorkflowWatchSourceCdcCheckpoints      DataWorkflowWatchSourceCdcCheckpoint[]
  dataWorkflowWatchSourceNotificationBatches DataWorkflowWatchSourceNotificationBatch[]
  dataWorkflowWatchSourceNotifications       DataWorkflowWatchSourceNotification[]
  dataWorkflowWatchSourceDeliveryAssignments DataWorkflowWatchSourceDeliveryAssignment[]
  tutorialProgress                           TutorialProgress[]
  tutorialOnboardingDecisions                TutorialOnboardingDecision[]
  tutorialCompletions                        TutorialCompletion[]

  @@map("organizations")
  @@schema("celesnity_app")
}

model PlantSite {
  id                     String                      @id @db.Uuid
  organizationId         String                      @default(dbgenerated()) @map("organization_id") @db.Uuid
  name                   String                      @db.VarChar(160)
  code                   String                      @db.VarChar(120)
  timezone               String                      @db.VarChar(80)
  draft                  Json
  referenceData          Json                        @map("reference_data")
  revision               Int                         @default(1)
  latestPublishedVersion Int?                        @map("latest_published_version")
  publishedRevision      Int?                        @map("published_revision")
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization           Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions               PlantModelVersion[]
  dashboards             PlantDashboardAssociation[]

  @@index([organizationId, updatedAt])
  @@map("plant_sites")
  @@schema("celesnity_app")
}

model PlantModelVersion {
  id             String       @id @db.Uuid
  organizationId String       @default(dbgenerated()) @map("organization_id") @db.Uuid
  siteId         String       @map("site_id") @db.Uuid
  versionNumber  Int          @map("version_number")
  revision       Int
  snapshot       Json
  note           String?      @db.VarChar(400)
  publishedBy    String       @map("published_by") @db.VarChar(320)
  publishedAt    DateTime     @map("published_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site           PlantSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, versionNumber])
  @@index([organizationId, publishedAt])
  @@map("plant_model_versions")
  @@schema("celesnity_app")
}

model PlantDashboardAssociation {
  organizationId String       @map("organization_id") @db.Uuid
  siteId         String       @map("site_id") @db.Uuid
  dashboardId    String       @map("dashboard_id") @db.Uuid
  role           String       @db.VarChar(30)
  displayOrder   Int          @default(0) @map("display_order")
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site           PlantSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  dashboard      Dashboard    @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@id([siteId, dashboardId])
  @@index([organizationId, siteId, displayOrder])
  @@map("plant_dashboard_associations")
  @@schema("celesnity_app")
}

model UserIdentity {
  id                  String                     @id @db.Uuid
  provider            String                     @db.VarChar(80)
  subject             String                     @db.VarChar(128)
  identityTenantId    String?                    @map("identity_tenant_id") @db.VarChar(128)
  email               String?                    @db.VarChar(320)
  displayName         String?                    @map("display_name") @db.VarChar(200)
  emailVerified       Boolean                    @default(false) @map("email_verified")
  status              IdentityStatus             @default(ACTIVE)
  lastLoginAt         DateTime?                  @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships         OrganizationMembership[]
  serviceIdentity             OrganizationServiceIdentity?
  acceptedInvitations OrganizationInvitation[]   @relation("InvitationAcceptedBy")
  auditEvents         AuditEvent[]
  groupMemberships    AuthorizationGroupMember[]
  directCatalogGrants CatalogAccessGrant[]
  boundAgentRooms     AgentRoomBinding[]         @relation("AgentRoomBoundBy")
  dashboardsCreated   Dashboard[]                @relation("DashboardCreatedBy")
  tutorialProgress            TutorialProgress[]
  tutorialOnboardingDecisions TutorialOnboardingDecision[]
  tutorialCompletions         TutorialCompletion[]
  oauthConnections            OauthConnection[]

  @@unique([provider, identityTenantId, subject])
  @@index([email])
  @@map("user_identities")
  @@schema("celesnity_app")
}

model OauthConnection {
  id                    String                @id @db.Uuid
  identityId            String                @map("identity_id") @db.Uuid
  provider              String                @db.VarChar(80)
  externalAccountId     String                @map("external_account_id") @db.VarChar(255)
  status                OauthConnectionStatus @default(ACTIVE)
  scopes                String[]              @default([])
  encryptedTokenPayload String                @map("encrypted_token_payload") @db.Text
  encryptionIv          String                @map("encryption_iv") @db.VarChar(255)
  encryptionAuthTag     String                @map("encryption_auth_tag") @db.VarChar(255)
  encryptionKeyVersion  String                @map("encryption_key_version") @db.VarChar(50)
  tokenExpiresAt        DateTime              @map("token_expires_at") @db.Timestamptz(6)
  providerData          Json                  @default("{}") @map("provider_data")
  connectedAt           DateTime              @default(now()) @map("connected_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  identity              UserIdentity          @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, provider, externalAccountId])
  @@index([identityId, provider])
  @@map("oauth_connections")
  @@schema("celesnity_app")
}

model OrganizationMembership {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  identityId     String           @map("identity_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  expiresAt      DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity       UserIdentity     @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, identityId])
  @@index([identityId, status])
  @@map("organization_memberships")
  @@schema("celesnity_app")
}

// Explicitly provisioned, per-organization service actor. No default grants.
model OrganizationServiceIdentity {
  organizationId String       @map("organization_id") @db.Uuid
  purpose        String       @default("BACKGROUND") @db.VarChar(32)
  identityId     String       @unique @map("identity_id") @db.Uuid
  enabled        Boolean      @default(false)
  permissions    String[]     @default([])
  features       String[]     @default([])
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity       UserIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@id([organizationId, purpose])
  @@map("organization_service_identities")
  @@schema("celesnity_app")
}

model AuthorizationGroup {
  id                          String                     @id @db.Uuid
  organizationId              String                     @map("organization_id") @db.Uuid
  name                        String                     @db.VarChar(120)
  description                 String?                    @db.VarChar(500)
  systemKey                   String?                    @map("system_key") @db.VarChar(80)
  featureVisibilityConfigured Boolean                    @default(false) @map("feature_visibility_configured")
  visibleFeatures             String[]                   @default([]) @map("visible_features")
  createdAt                   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization                Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members                     AuthorizationGroupMember[]
  catalogGrants               CatalogAccessGrant[]
  chartCollectionGrants       ChartCollectionGrant[]

  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
  @@index([organizationId])
  @@map("authorization_groups")
  @@schema("celesnity_app")
}

model AuthorizationGroupMember {
  id         String             @id @db.Uuid
  groupId    String             @map("group_id") @db.Uuid
  identityId String             @map("identity_id") @db.Uuid
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  group      AuthorizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  identity   UserIdentity       @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([groupId, identityId])
  @@index([identityId])
  @@map("authorization_group_members")
  @@schema("celesnity_app")
}

model CatalogAccessGrant {
  id                 String              @id @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  groupId            String?             @map("group_id") @db.Uuid
  identityId         String?             @map("identity_id") @db.Uuid
  agentName          String?             @map("agent_name") @db.VarChar(120)
  resourceType       CatalogResourceType @map("resource_type")
  resourceId         String              @map("resource_id") @db.VarChar(255)
  permissions        CatalogPermission[]
  effect             PolicyEffect        @default(ALLOW)
  includeDescendants Boolean             @default(false) @map("include_descendants")
  grantOption        Boolean             @default(false) @map("grant_option")
  validFrom          DateTime?           @map("valid_from") @db.Timestamptz(6)
  expiresAt          DateTime?           @map("expires_at") @db.Timestamptz(6)
  createdById        String              @map("created_by_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group              AuthorizationGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  identity           UserIdentity?       @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([organizationId, resourceType, resourceId])
  @@index([groupId])
  @@index([identityId])
  @@index([organizationId, agentName])
  @@map("catalog_access_grants")
  @@schema("celesnity_app")
}

model CatalogNamespaceDescription {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  catalog        String       @db.VarChar(255)
  namespace      String       @db.VarChar(255)
  description    String?      @db.VarChar(1000)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The physical Trino/Iceberg catalog is shared, so a namespace can belong to
  // exactly one organization. Tenant-scoped uniqueness would allow two rows to
  // authorize the same physical schema for two different organizations.
  @@unique([catalog, namespace])
  @@index([organizationId, catalog])
  @@map("catalog_namespace_descriptions")
  @@schema("celesnity_app")
}

model AgentRoomBinding {
  roomId           String       @id @map("room_id") @db.VarChar(255)
  organizationId   String       @map("organization_id") @db.Uuid
  boundById        String       @map("bound_by_id") @db.Uuid
  agentName        String?      @map("agent_name") @db.VarChar(120)
  mfaVerifiedUntil DateTime?    @map("mfa_verified_until") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  boundBy          UserIdentity @relation("AgentRoomBoundBy", fields: [boundById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, agentName])
  @@map("agent_room_bindings")
  @@schema("celesnity_app")
}

// Browser-selected scope is registered by an authenticated human before Agent
// admission. MCP metadata is only a lookup key; it never supplies the scope.
model AgentRunScope {
  runId          String       @id @map("run_id") @db.Uuid
  roomId         String       @map("room_id") @db.VarChar(255)
  organizationId String       @map("organization_id") @db.Uuid
  boundById      String       @map("bound_by_id") @db.Uuid
  agentName      String       @map("agent_name") @db.VarChar(120)
  catalog        String?      @db.VarChar(255)
  schema         String?      @db.VarChar(255)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  closedAt       DateTime?    @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([roomId, organizationId])
  @@index([expiresAt])
  @@map("agent_run_scopes")
  @@schema("celesnity_app")
}

model OrganizationInvitation {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String           @db.VarChar(320)
  role           OrganizationRole
  tokenHash      String           @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
  acceptedById   String?          @map("accepted_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acceptedBy     UserIdentity?    @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@map("organization_invitations")
  @@schema("celesnity_app")
}

model AuditEvent {
  id              String        @id @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  actorIdentityId String?       @map("actor_identity_id") @db.Uuid
  sessionId       String?       @map("session_id") @db.VarChar(128)
  requestId       String?       @map("request_id") @db.VarChar(128)
  eventType       String        @map("event_type") @db.VarChar(120)
  action          String        @db.VarChar(160)
  resourceType    String?       @map("resource_type") @db.VarChar(120)
  resourceId      String?       @map("resource_id") @db.VarChar(255)
  outcome         String        @db.VarChar(30)
  ipAddressHash   String?       @map("ip_address_hash") @db.Char(64)
  userAgent       String?       @map("user_agent") @db.VarChar(512)
