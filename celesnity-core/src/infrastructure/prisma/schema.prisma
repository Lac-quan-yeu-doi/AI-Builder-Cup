  contactLostAt                  DateTime?                   @map("contact_lost_at") @db.Timestamptz(6)
  lastSeenAt                     DateTime?                   @map("last_seen_at") @db.Timestamptz(6)
  lastError                      String?                     @map("last_error") @db.Text
  lastReconciledAt               DateTime?                   @map("last_reconciled_at") @db.Timestamptz(6)
  reconcileAfter                 DateTime                    @default(now()) @map("reconcile_after") @db.Timestamptz(6)
  reconciliationFailures         Int                         @default(0) @map("reconciliation_failures")
  createdAt                      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
