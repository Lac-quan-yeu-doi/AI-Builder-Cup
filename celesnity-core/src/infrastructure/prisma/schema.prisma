generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["celesnity_app"]
}

enum VerificationStatus {
  UNTESTED
  SUCCEEDED
  FAILED

  @@schema("celesnity_app")
}

enum CdcConnectionSetupMode {
  EXISTING
  MANAGED

  @@schema("celesnity_app")
}

enum CdcConnectionVerificationStatus {
  UNTESTED
  READY
  SETUP_REQUIRED
  FAILED

  @@schema("celesnity_app")
}

enum ScriptStatus {
  ACTIVE
  ARCHIVED

  @@schema("celesnity_app")
}

enum ExecutionStatus {
  QUEUED
  PREPARING
  SUBMITTED
  RUNNING
  CANCELLING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT

  @@schema("celesnity_app")
}

enum SqlExecutionStatus {
  QUEUED
  SUBMITTED
  RUNNING
  CANCELLING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT

  @@schema("celesnity_app")
}

enum OutboxStatus {
