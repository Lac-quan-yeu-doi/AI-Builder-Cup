{
  "name": "celesnity-core",
  "version": "0.1.0",
  "private": true,
  "description": "Celesnity control plane and Spark execution worker",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,ts,mjs}\" && prisma format",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,ts,mjs}\"",
    "openapi:export": "node dist/bootstrap/openapi-export.js",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "start": "node dist/bootstrap/api-main.js",
    "start:dev": "nest start --watch --entryFile bootstrap/api-main",
    "start:worker": "node dist/bootstrap/worker-main.js",
    "start:worker:dev": "nest start --watch --entryFile bootstrap/worker-main",
    "test:data-workflow:integration": "node scripts/run-data-workflow-integration.mjs",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@prometheus-io/client": "0.16.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cron-parser": "^5.10.0",
    "csv-parse": "^7.0.2",
    "dt-sql-parser": "4.5.1",
    "exceljs": "^4.4.0",
    "firebase-admin": "14.3.0",
    "google-auth-library": "10.9.1",
    "jiti": "2.7.0",
    "kafkajs": "2.2.4",
    "minio": "8.0.7",
    "mysql2": "3.15.3",
    "node-sql-parser": "^5.4.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.3",
    "@types/supertest": "6.0.3",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "supertest": "7.1.4",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "overrides": {
    "@google-cloud/storage": "8.0.1",
    "deepmerge-ts": "8.0.2",
    "js-yaml": "5.2.3",
    "retry-request": "9.0.1",
    "teeny-request": "11.0.1",
    "uuid": "11.1.1"
  }
}
