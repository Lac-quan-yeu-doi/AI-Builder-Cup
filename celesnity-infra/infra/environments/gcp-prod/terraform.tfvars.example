# This file is intentionally non-secret and is the committed input used by
# cloudbuild.yaml. Secret values are generated by Terraform and retained in the
# encrypted, versioned GCS state bucket.

project_id = "celesnity-minder-platform"
project    = "celesnity"
environment = "gcp-prod"
identity_tenant_id_source_version = "2"

# Dedicated production project in London. Every regional data service inherits
# this location, including Cloud SQL, GCS, GKE nodes, and persistent disks.
region = "europe-west2"
zone   = null
regional_cluster_zones = [
  "europe-west2-a",
  "europe-west2-b",
  "europe-west2-c",
]

# Do not overlap the development VPC ranges (10.30/10.31/10.32).
subnet_cidr           = "10.40.0.0/20"
pods_cidr             = "10.41.0.0/16"
services_cidr         = "10.42.0.0/20"
master_ipv4_cidr_block = "172.16.1.0/28"

release_channel             = "STABLE"
cluster_deletion_protection = true
enable_private_endpoint     = false # Cloud Build must reach the regional API endpoint.

# One node per zone means three stable application nodes in a regional cluster.
node_machine_type = "e2-standard-2"
node_count        = 1
node_min_count    = 1
node_max_count    = 2
node_disk_size_gb = 30
node_disk_type    = "pd-balanced"
node_spot         = false

# One dedicated streaming node per zone. Redpanda and EMQX each run three
# replicas and Redpanda uses the zone label as its rack/failure-domain ID.
streaming_node_count             = 1
streaming_node_disk_size_gb      = 50
streaming_node_disk_type         = "pd-standard"
streaming_data_disk_type         = "pd-standard"
redpanda_replicas                = 3
mqtt_broker_replicas             = 3
redpanda_storage_size            = "50Gi"
mqtt_broker_storage_size         = "20Gi"
# E2 is sufficient for the lean initial broker profile, costs less than N2,
# and avoids the N2 capacity exhaustion observed across the London regional
# pool during the first production deployment.
redpanda_node_machine_type       = "e2-standard-4"
redpanda_tls_enabled             = true
redpanda_rack_awareness_enabled  = true
cert_manager_chart_version       = "v1.21.1"

# Independent regional production Cloud SQL instance with backups and PITR.
db_edition                        = "ENTERPRISE"
db_tier                           = "db-custom-2-7680"
db_disk_size_gb                   = 50
db_version                        = "POSTGRES_17"
db_name                           = "celesnity"
db_username                       = "celesnity"
db_availability_type             = "REGIONAL"
db_backup_enabled                = true
db_point_in_time_recovery_enabled = true
db_retained_backups              = 14
db_deletion_protection           = true

# Explicit names make the production storage boundary auditable. These are not
# shared with development even though both environments use the same project.
warehouse_bucket_name = "celesnity-gcp-prod-warehouse-celesnity-minder-platform"
artifacts_bucket_name = "celesnity-gcp-prod-artifacts-celesnity-minder-platform"
force_destroy_buckets = false
noncurrent_version_retention_days = 30

workload_namespace  = "celesnity-prod"
trino_tls_secret_version         = "1"
trino_ca_secret_version          = "1"
trino_user_password_secret_version = "1"
trino_shared_secret_version        = "1"
trino_kubernetes_secret_revision = 1
monitoring_namespace = "celesnity-prod-monitoring"
install_observability = true
install_loki          = true
install_grafana       = true
loki_retention_hours  = 720
enable_managed_prometheus = true
agent_namespace           = "minder-prod"

enable_data_access_logs = true
log_retention_days      = 90

# The operator creates two global Certificate Manager certificates and manages
# Cloudflare DNS out of band. The shared HTTPS Gateway certificate covers the
# browser/API/Trino hostnames, while MQTT has a dedicated certificate for
# the global SSL proxy on port 8883.
enable_external_lb  = true
lb_hostname         = "trino.celesnity.com"
lb_certificate_name = "celesnity-prod-https"
lb_additional_hostnames = [
  "api.celesnity.com",
  "app.celesnity.com",
  "control.celesnity.com",
  "grafana.celesnity.com",
]
application_hostname = "app.celesnity.com"
# Set at least one verified destination before production sign-off.
monitoring_notification_email_addresses = [
  "dax.pham@celesnity.com",
]
# Publish Grafana through the shared HTTPS Gateway. The production certificate
# must cover this name; create a DNS-only A record pointing at trino_lb_address.
grafana_hostname       = "grafana.celesnity.com"
mqtt_hostname          = "mqtt.celesnity.com"
mqtt_certificate_name = "celesnity-prod-mqtt"
mqtt_dns_managed_zone  = "" # Cloudflare is managed out of band.

# Empty is intentionally explicit for the initial handoff. Before public DNS is
# enabled, replace this with operator/VPN CIDRs or deliberately approve public
# reachability. Core application authentication remains disabled by request.
lb_allowed_source_ranges = []
