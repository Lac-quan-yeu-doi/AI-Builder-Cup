// Kubernetes container log collection.
//
// Rendered by Terraform from infra/modules/observability/config/logs.alloy.tftpl.
// Alloy runs as a DaemonSet and tails files under /var/log/pods on its own node,
// rather than streaming through the Kubernetes API. That keeps API server load
// flat as pod count grows, at the cost of a hostPath mount.

// Discover pods scheduled on THIS node only. Without the field selector every
// Alloy pod would discover every pod in the cluster and then tail files that do
// not exist locally.
discovery.kubernetes "pods" {
  role = "pod"

  selectors {
    role  = "pod"
    field = "spec.nodeName=" + sys.env("NODE_NAME")
  }
}

// Turn Kubernetes metadata into Loki labels and build the on-disk log path.
//
// Keep the label set small and low-cardinality. Every distinct combination of
// label values creates a separate Loki stream, and stream count is what makes
// Loki slow and expensive. pod name is included because it is the practical unit
// of debugging; anything higher-cardinality (container id, request id) belongs in
// the log line, not a label.
discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pods.targets

%{ if length(log_namespaces) > 0 ~}
  // Restrict collection to the namespaces that matter.
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "${join("|", log_namespaces)}"
    action        = "keep"
  }

%{ endif ~}
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }

  // Populated by the app.kubernetes.io labels the Trino and Spark manifests set,
  // so `{app="trino", component="worker"}` works as a query.
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "app"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_component"]
    target_label  = "component"
  }

  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "node"
  }

  // Log files live at:
  //   /var/log/pods/<namespace>_<pod>_<uid>/<container>/N.log
  // The leading glob absorbs the namespace_pod_ prefix.
  rule {
    source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
    separator     = "/"
    action        = "replace"
    replacement   = "/var/log/pods/*$1/*.log"
    target_label  = "__path__"
  }
}

local.file_match "pod_logs" {
  path_targets = discovery.relabel.pod_logs.output
}

loki.source.file "pod_logs" {
  targets    = local.file_match.pod_logs.targets
  forward_to = [loki.process.pod_logs.receiver]
}

loki.process "pod_logs" {
  forward_to = [loki.write.default.receiver]

  // containerd writes the CRI format: "<RFC3339Nano> <stream> <tags> <message>".
  // This stage extracts the real timestamp and stream so Loki does not index the
  // wrapper as part of the message.
  stage.cri {}

  // Promote the stream to a label so stderr can be isolated:
  //   {app="trino", stream="stderr"}
  stage.labels {
    values = {
      stream = "",
    }
  }

%{ if drop_healthcheck_logs ~}
  // Readiness and liveness probes fire every 10 seconds per pod. On an idle
  // cluster they are the majority of log volume, and they carry no signal.
  stage.drop {
    expression          = "(?i)(GET /v1/info|/minio/health/live|health-check|kube-probe)"
    drop_counter_reason = "healthcheck_noise"
  }

%{ endif ~}
  // Guard against a single pod flooding ingest. Lines above the burst are dropped
  // rather than buffered, which protects Loki and the cost line at the expense of
  // completeness during an incident.
  stage.limit {
    rate  = 500
    burst = 1000
    drop  = true
  }
}

loki.write "default" {
  endpoint {
    url = "${loki_push_url}"
  }

  // Alloy buffers in memory only. A Loki restart loses at most this window; the
  // alternative is a WAL on a hostPath, which is more state than a PoC warrants.
  external_labels = {
    cluster = "${cluster_label}",
  }
}
