{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "description": "RED rate: completed Core and Agent requests per second.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
        "promQLQuery": { "expr": "sum by (service) (rate(http_server_requests_total[5m]))", "projectName": "__PROJECT_ID__", "step": "$__interval" },
        "timeSeriesList": {},
        "queryType": "promQL",
        "refId": "A"
      }],
      "title": "Request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "description": "RED errors: percentage of completed requests returning 5xx.",
      "fieldConfig": { "defaults": { "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
        "promQLQuery": { "expr": "100 * sum by (service) (rate(http_server_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum by (service) (rate(http_server_requests_total[5m])), 0.001)", "projectName": "__PROJECT_ID__", "step": "$__interval" },
        "timeSeriesList": {},
        "queryType": "promQL",
        "refId": "A"
      }],
      "title": "5xx error rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "description": "RED duration: 95th percentile server response time.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
        "promQLQuery": { "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_server_request_duration_seconds_bucket[5m])))", "projectName": "__PROJECT_ID__", "step": "$__interval" },
        "timeSeriesList": {},
        "queryType": "promQL",
        "refId": "A"
      }],
      "title": "p95 request duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "description": "USE utilization: CPU cores consumed by application pods.",
      "fieldConfig": { "defaults": { "unit": "cores" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
        "promQLQuery": { "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{namespace=~\"celesnity|minder\", container!=\"\"}[5m]))", "projectName": "__PROJECT_ID__", "step": "$__interval" },
        "timeSeriesList": {},
        "queryType": "promQL",
        "refId": "A"
      }],
      "title": "Pod CPU utilization",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "description": "USE utilization: current application container working-set memory.",
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
        "promQLQuery": { "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{namespace=~\"celesnity|minder\", container!=\"\"})", "projectName": "__PROJECT_ID__", "step": "$__interval" },
        "timeSeriesList": {},
        "queryType": "promQL",
        "refId": "A"
      }],
      "title": "Pod memory utilization",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "description": "USE errors: container restarts during the last hour.",
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
        "promQLQuery": { "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"celesnity|minder\"}[1h]))", "projectName": "__PROJECT_ID__", "step": "$__interval" },
        "timeSeriesList": {},
        "queryType": "promQL",
        "refId": "A"
      }],
      "title": "Container restarts",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "description": "Rolling five-minute mean response time grouped by service, HTTP method, and normalized API route.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [{
        "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
        "promQLQuery": { "expr": "sum by (service, method, route) (rate(http_server_request_duration_seconds_sum[5m])) / sum by (service, method, route) (rate(http_server_request_duration_seconds_count[5m]))", "projectName": "__PROJECT_ID__", "step": "$__interval" },
        "timeSeriesList": {},
        "queryType": "promQL",
        "refId": "A"
      }],
      "title": "Average API response time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "__LOKI_DATASOURCE_UID__" },
      "description": "Application logs from Core, Web, Agent, Spark, and platform services. Use the search field to correlate a request ID.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 24 },
      "id": 7,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{
        "datasource": { "type": "loki", "uid": "__LOKI_DATASOURCE_UID__" },
        "editorMode": "code",
        "expr": "{namespace=~\".+\"}",
        "queryType": "range",
        "refId": "A"
      }],
      "title": "Application logs",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["celesnity", "red", "use"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Celesnity platform overview",
  "uid": "celesnity-platform-overview",
  "version": 1
}
