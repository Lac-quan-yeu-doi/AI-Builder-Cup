# PostgreSQL
POSTGRES_DB=celesnity
POSTGRES_USER=celesnity
POSTGRES_PASSWORD=celesnity_dev_password
POSTGRES_PORT=15432

# MinIO
MINIO_ROOT_USER=celesnity
MINIO_ROOT_PASSWORD=celesnity_minio_password
MINIO_BUCKET=warehouse
MINIO_ARTIFACTS_BUCKET=celesnity-artifacts
# Arbitrary for MinIO, but matched to the cloud region so Iceberg metadata
# written locally carries the same region string as on AWS.
MINIO_REGION=ap-southeast-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Local explicit FTPS inbound connector.
# Clients connect to 127.0.0.1:2121 with AUTH TLS and passive ports 50000-50009.
# This is intentionally local-only. The deployed public endpoint is configured
# in celesnity-core/k8s/overlays/gcp-dev/configmap.yaml, not in this Compose file.
FTPS_CONTROL_PORT=2121
# Public endpoint metadata passed to Core for local external clients.
FTPS_PUBLIC_HOST=127.0.0.1
# SFTPGo's passive IP field accepts an IPv4 address only. Leave the passive
# hostname empty for local Compose; it is published on loopback only.
FTPS_PASSIVE_IP=127.0.0.1
FTPS_PASSIVE_HOST=
FTPS_PASSIVE_PORT_START=50000
FTPS_PASSIVE_PORT_END=50009
# Optional browser-based FileZilla client: enable with --profile ftps-client.
FILEZILLA_WEB_PORT=5800
FILEZILLA_DISPLAY_WIDTH=1440
FILEZILLA_DISPLAY_HEIGHT=900
FTPS_DEMO_USERNAME=ftps-demo-user
FTPS_DEMO_PASSWORD=replace-with-a-local-ftps-password
FTPS_BOOTSTRAP_ADMIN_USERNAME=ftps-bootstrap-admin
FTPS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-bootstrap-password
FTPS_STATUS_USERNAME=ftps-status-monitor
FTPS_STATUS_PASSWORD=replace-with-a-local-ftps-status-password
# Set to 1 only for an explicit monitoring-password reset.
FTPS_STATUS_RESET_PASSWORD=0
FTPS_SFTPGO_MASTER_KEY=replace-with-a-high-entropy-local-master-key
FTPS_INGRESS_BUCKET=celesnity-ingress
FTPS_MINIO_ACCESS_KEY=celesnity-ftps
FTPS_MINIO_ACCESS_SECRET=replace-with-a-local-storage-secret
FTPS_TENANT_PREFIX=tnt_localdemo000
FTPS_SFTPGO_FOLDER_NAME=ftps-demo-incoming

# Trino cluster: one coordinator plus TRINO_WORKER_REPLICAS workers.
# The container jvm.config sets the heap to 80% of the memory limit, so
# TRINO_QUERY_MAX_MEMORY_PER_NODE must stay below (heap - 30% heap headroom).
#
# TRINO_QUERY_MAX_MEMORY is the cluster-wide budget, not per-node. It must equal
# TRINO_WORKER_REPLICAS x TRINO_QUERY_MAX_MEMORY_PER_NODE; raising replicas alone
# lets the planner admit queries larger than the workers can hold.
#
# These values mirror deploy/base/trino/ so local behaviour matches EKS.
TRINO_PORT=18082
TRINO_WORKER_REPLICAS=1
TRINO_COORDINATOR_MEMORY=1024m
TRINO_WORKER_MEMORY=1024m
TRINO_QUERY_MAX_MEMORY=400MB
TRINO_QUERY_MAX_MEMORY_PER_NODE=400MB

# Spark standalone cluster: one master plus SPARK_WORKER_REPLICAS workers.
ICEBERG_VERSION=1.11.0
POSTGRES_JDBC_VERSION=42.7.13
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8081
SPARK_WORKER_REPLICAS=1
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=1g

# Managed EMQX local broker. These are disposable local-development credentials.
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_PASSWORD=celesnity_emqx_dashboard_password
MQTT_CONNECT_USERNAME=celesnity-connect
MQTT_CONNECT_PASSWORD=celesnity_connect_password
MQTT_DEVICE_USERNAME=adp_a6381ab6d85540228482e1d2f77ddb71
MQTT_DEVICE_PASSWORD=KSTdN9ScPWVtwI3Z4vjpbFcMiaMrKptRwrgsjpVPK1U

# Redpanda local broker and tools.
REDPANDA_USERNAME=celesnity-admin
REDPANDA_PASSWORD=celesnity_redpanda_password
REDPANDA_PORT=19092
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_ADMIN_PORT=19644
REDPANDA_CONSOLE_PORT=18080
REDPANDA_CONNECT_PORT=14195
# Required on Apple Silicon because the Connect 4.104.0 arm64 binary exits 139.
REDPANDA_CONNECT_PLATFORM=linux/amd64
REDPANDA_RAW_PARTITIONS=12
REDPANDA_RAW_RETENTION_MS=86400000
REDPANDA_DLQ_RETENTION_MS=604800000
REDPANDA_AUDIT_RETENTION_MS=2592000000

# Local Debezium CDC runtime. Enable with: docker compose --profile cdc up -d --build --wait
DATA_WORKFLOW_CDC_TOPIC=celesnity.data-workflow.cdc.v1
DATA_WORKFLOW_CDC_PARTITIONS=6
DATA_WORKFLOW_CDC_RETENTION_MS=604800000
DEBEZIUM_CONNECT_PORT=18083
DEBEZIUM_BOOTSTRAP_SERVERS=redpanda:9092
DEBEZIUM_GROUP_ID=celesnity-debezium-connect
DEBEZIUM_CONFIG_STORAGE_TOPIC=celesnity.debezium.configs
DEBEZIUM_OFFSET_STORAGE_TOPIC=celesnity.debezium.offsets
DEBEZIUM_STATUS_STORAGE_TOPIC=celesnity.debezium.status
