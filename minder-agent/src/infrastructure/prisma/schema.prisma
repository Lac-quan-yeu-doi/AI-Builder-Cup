generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                String   @id @db.Uuid
  key               String
  mode              String
  history           Json
  pendingQuestion   Json?    @map("pending_question")
  pendingClientTool Json?    @map("pending_client_tool")
  pendingPlan       Json?    @map("pending_plan")
  pendingApproval   Json?    @map("pending_approval")
  loopSnapshot      Json?    @map("loop_snapshot")
  turns             Int      @default(0)
  owner             String
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  @@unique([owner, key], map: "sessions_owner_key")
  @@map("sessions")
}

model Run {
  id            String    @id @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  status        String
  mode          String
  triggerSource String    @map("trigger_source")
  deliveryId    String?   @map("delivery_id")
  input         String
  manifestName  String?   @map("manifest_name")
  manifestOwner String?   @map("manifest_owner")
  dataScope     Json?     @map("data_scope")
  context       Json?
  delegation    Json?
  responseText  String    @default("") @map("response_text")
  error         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  finishedAt    DateTime? @map("finished_at")

  @@index([sessionId, createdAt(sort: Desc)], map: "idx_runs_session_created")
  @@map("runs")
}

model RunGovernancePolicy {
  runId       String   @id @map("run_id") @db.Uuid
  owner       String
  revisionHash String  @map("revision_hash")
  policy      Json?
  summary     Json
  admittedAt  DateTime @map("admitted_at")
  @@map("run_governance_policies")
}

model RunGovernanceEvidence {
  id      String   @id @db.Uuid
  runId   String   @map("run_id") @db.Uuid
  owner   String
  seq     BigInt
  kind    String
  detail  Json
  at      DateTime
  @@unique([runId, seq])
  @@map("run_governance_evidence")
}

model TriggerDelivery {
  source     String
  deliveryId String   @map("delivery_id")
  claimedAt  DateTime @default(now()) @map("claimed_at")
  @@id([source, deliveryId])
  @@map("trigger_deliveries")
}

model RunEvent {
  runId     String   @map("run_id") @db.Uuid
  seq       Int
  event     Json
  createdAt DateTime @default(now()) @map("created_at")
  @@id([runId, seq])
  @@map("run_events")
}

model RunApproval {
  id            String    @id @db.Uuid
  owner         String
  runId         String    @map("run_id") @db.Uuid
  toolCallId    String    @map("tool_call_id")
  action        String
  argumentsHash String    @map("arguments_hash")
  preview       String
  status        String
  createdAt     DateTime  @map("created_at")
  expiresAt     DateTime  @map("expires_at")
  decidedAt     DateTime? @map("decided_at")
  @@index([owner, runId, createdAt], map: "run_approvals_owner_run_created")
  @@map("run_approvals")
}

model RunApprovalExecutionClaim {
  approvalId String    @id @map("approval_id") @db.Uuid
  owner      String
  runId      String    @map("run_id") @db.Uuid
  state      String
  claimedAt  DateTime  @default(now()) @map("claimed_at")
  completedAt DateTime? @map("completed_at")
  @@map("run_approval_execution_claims")
}

model RunFileAccess {
  runId     String   @map("run_id") @db.Uuid
  path      String
  operation String
  at        DateTime
  @@id([runId, path, operation, at])
  @@map("run_file_accesses")
}

model RunManifest {
  runId       String   @id @map("run_id") @db.Uuid
  manifest    Json
  createdAt   DateTime  @map("created_at")
  @@map("run_manifests")
}

model Skill {
  owner       String
  name        String
  namespace   String
  description String?
  body        String
  hash        String
  source      String
  readOnly    Boolean  @default(false) @map("read_only")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  @@id([owner, name])
  @@map("skills")
}

model Agent {
  owner             String
  id                String
  name              String
  displayName       String?  @map("display_name")
  systemPrompt      String?  @map("system_prompt")
  model             String?
  toolAllowlist     Json     @map("tool_allowlist")
  skills            Json
  maxSteps          Int?     @map("max_steps")
  executionStrategy String   @map("execution_strategy")
  configHash        String   @map("config_hash")
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime @default(now()) @map("created_at")
  @@id([owner, id])
  @@unique([owner, name])
  @@map("agents")
}

model AgentRevision {
  owner      String
  agentId    String   @map("agent_id")
  version    Int
  snapshot   Json
  configHash String   @map("config_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  @@id([owner, agentId, version])
  @@map("agent_revisions")
}

model Room {
  id                 String    @id @db.Uuid
  owner              String
  key                String?
  name               String
  maxConcurrentRuns  Int       @map("max_concurrent_runs")
  maxQueued          Int       @map("max_queued")
  status             String    @default("open")
  createdAt          DateTime  @default(now()) @map("created_at")
  @@unique([owner, key], map: "rooms_owner_key_unique")
  @@map("rooms")
}

model RoomMember {
  roomId    String @map("room_id") @db.Uuid
  agentName String @map("agent_name")
  @@id([roomId, agentName])
  @@map("room_members")
}

model RoomRun {
  roomId    String   @map("room_id") @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  @@id([roomId, runId])
  @@map("room_runs")
}

model RoomWebhook {
  id        String   @id @db.Uuid
  owner     String
  roomId    String   @map("room_id") @db.Uuid
  agentName String   @map("agent_name")
  source    String
  secretRef String   @map("secret_ref")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("room_webhooks")
}

model RoomQueueItem {
  roomId    String   @map("room_id") @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  payload   Json
  position  Int
  state     String
  createdAt DateTime @map("created_at")
  @@id([roomId, runId])
  @@map("room_queue_items")
}

model RoomEvent {
  roomId    String   @map("room_id") @db.Uuid
  seq       BigInt
  event     Json
  createdAt DateTime @default(now()) @map("created_at")
  @@id([roomId, seq])
  @@map("room_events")
}

model MinderSchemaMigration {
  version   Int      @id
  appliedAt DateTime @default(now()) @map("applied_at")
  @@map("minder_schema_migrations")
}
