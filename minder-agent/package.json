{
  "name": "minder-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "cli": "tsx src/presentation/cli/bin.ts",
    "test": "vitest run",
    "test:architecture": "vitest run --project architecture",
    "test:compat": "vitest run --project compat",
    "test:phase-0": "vitest run --project phase-0",
    "test:phase-1": "vitest run --project phase-1",
    "test:phase-2": "vitest run --project phase-2",
    "test:phase-3": "vitest run --project phase-3",
    "test:phase-4": "vitest run --project phase-4",
    "test:release": "vitest run --project release",
    "db:reset:minder": "tsx src/bootstrap/reset-cli.ts",
    "db:compact:v2": "tsx src/bootstrap/compact-v2-cli.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/bootstrap/http-main.ts",
    "openapi:export": "tsx src/bootstrap/openapi-cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.0.11",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prisma": "^6.19.0",
    "tsc-alias": "^1.9.5",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.16",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "langchain": "^1.5.11",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
