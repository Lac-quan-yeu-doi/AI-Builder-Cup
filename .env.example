# =============================================================================
# Global docker-compose environment variables
# Copy this file to .env and fill in required values.
# =============================================================================

# --- LLM (required for minder-agent runtime) ---------------------------------
LLM_BASE_URL=http://litellm-litellm-0246bd-14-225-206-18.sslip.io/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_TEMPERATURE=

# --- Public origin ------------------------------------------------------------
# Exact browser origin served by nginx (scheme + host [+ port]); web and core
# use it for Origin/CSRF checks. On a VPS: http://<VPS_IP>
WEB_ORIGIN=http://localhost

# --- PostgreSQL (celesnity infra) --------------------------------------------
POSTGRES_DB=celesnity
POSTGRES_USER=celesnity
POSTGRES_PASSWORD=celesnity_dev_password
POSTGRES_PORT=15432

# --- Mock source data (sample-postgres, see mock-data/README.md) -------------
SAMPLE_POSTGRES_DB=sample
SAMPLE_POSTGRES_USER=sample
SAMPLE_POSTGRES_PASSWORD=sample_dev_password
SAMPLE_POSTGRES_PORT=15433

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=celesnity
MINIO_ROOT_PASSWORD=celesnity_minio_password
MINIO_BUCKET=warehouse
MINIO_ARTIFACTS_BUCKET=celesnity-artifacts
MINIO_WORKSPACE_BUCKET=minder-workspace
MINIO_REGION=ap-southeast-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Trino -------------------------------------------------------------------
TRINO_PORT=8080
TRINO_WORKER_REPLICAS=0
TRINO_COORDINATOR_MEMORY=896M
TRINO_WORKER_MEMORY=896M
TRINO_QUERY_MAX_MEMORY=256MB
TRINO_QUERY_MAX_MEMORY_PER_NODE=256MB
TRINO_USER=minder_agent
TRINO_CATALOG=saigonfood

# --- Semantica ---------------------------------------------------------------
SEMANTICA_URL=http://semantica:8000
SEMANTICA_API_KEY=
SEMANTICA_ALLOW_ANONYMOUS=true
SEMANTICA_PORT=8000

# --- Autonomous Trino anomaly worker -----------------------------------------
# Set to true only after setting the dataset identifiers below.
ANOMALY_WORKER_ENABLED=false
ANOMALY_DATASET_CATALOG=saigonfood
ANOMALY_DATASET_SCHEMA=demo
ANOMALY_DATASET_TABLE=events
ANOMALY_TIMESTAMP_COLUMN=
ANOMALY_KEY_COLUMN=
ANOMALY_NULL_COLUMN=
ANOMALY_NUMERIC_COLUMN=
ANOMALY_WORKER_INTERVAL_SECS=30
ANOMALY_FRESHNESS_THRESHOLD_MINUTES=60
ANOMALY_NULL_RATE_THRESHOLD=0.05
ANOMALY_DUPLICATE_RATE_THRESHOLD=0.01
ANOMALY_WORKER_ANNOTATE=false
ANOMALY_WORKER_MAX_CONCURRENT_RUNS=1
ANOMALY_WORKER_MAX_QUEUED=4

# --- Spark -------------------------------------------------------------------
ICEBERG_VERSION=1.11.0
POSTGRES_JDBC_VERSION=42.7.13
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8081
SPARK_WORKER_REPLICAS=0
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=512m

# --- Minder Agent Runtime ----------------------------------------------------
RUST_LOG=minder_serve=info,minder_agent=info

# --- Plant walkthroughs (Gemini) ---------------------------------------------
# A Google AI Studio key. Without it the walkthrough screen only shows its sample.
GEMINI_API_KEY=
# GEMINI_WALKTHROUGH_MODEL=gemini-flash-latest
