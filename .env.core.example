NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
IDENTITY_PLATFORM_PROJECT_ID=replace-with-gcp-project-id
CELESNITY_AUTH_MODE=local-development
# Local workstations only. Run `npm run local:env` from ../celesnity-web to
# generate and synchronize this value. Never put it in Kubernetes.
LOCAL_DEV_AUTH_SIGNING_KEY=
DEFAULT_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
# Development-only HMAC key for pseudonymizing IP addresses in audit events.
AUDIT_HASH_KEY=replace-with-at-least-32-random-characters

DATABASE_URL=postgresql://celesnity:celesnity_dev_password@localhost:15432/celesnity?schema=celesnity_app

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=celesnity
MINIO_SECRET_KEY=celesnity_minio_password
MINIO_WAREHOUSE_BUCKET=warehouse
MINIO_ARTIFACTS_BUCKET=celesnity-artifacts
# Development-only signing seed. Production uses GCP KMS and never stores a private key here.
FIRMWARE_SIGNING_PROVIDER=LOCAL_ED25519
FIRMWARE_SIGNING_KEY_ID=local-dev
FIRMWARE_SIGNING_PRIVATE_KEY=nWGxne/9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A=
FIRMWARE_SIGNING_KMS_KEY_VERSION=
DEVICE_EXPECTED_CHECK_IN_INTERVAL_SECONDS=60
DEVICE_MISSED_CHECK_IN_THRESHOLD=3
DEVICE_CONTACT_MONITOR_INTERVAL_MS=5000
DEVICE_CONTACT_MONITOR_BATCH_SIZE=100
DEVICE_CONFIGURATION_CONFIRMATION_TIMEOUT_SECONDS=300
DEVICE_CONFIGURATION_MONITOR_INTERVAL_MS=5000
DEVICE_CONFIGURATION_MONITOR_BATCH_SIZE=100
FIRMWARE_BOOT_CONFIRMATION_TIMEOUT_SECONDS=300
FIRMWARE_CONFIRMATION_MONITOR_INTERVAL_MS=5000
FIRMWARE_CONFIRMATION_MONITOR_BATCH_SIZE=100
# Maximum 67108864 bytes preserves one conditional PUT with the pinned MinIO SDK; default is 1 MiB.
SCRIPT_SOURCE_MAX_BYTES=1048576

TRINO_URL=http://localhost:18082
SPARK_MASTER_URL=spark://localhost:7077

# Development-only key. Replace it in every deployed environment. Keep old versions for decryption during rotation.
CONNECTION_CREDENTIAL_KEYS=v1:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
CONNECTION_CREDENTIAL_ACTIVE_KEY_VERSION=v1
CONNECTION_ALLOW_PRIVATE_DESTINATIONS=true

# Google Drive connector OAuth. The redirect URI is derived from WEB_ORIGIN automatically.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CONNECTION_ALLOWED_HOSTS=host.docker.internal,sample-postgres
CONNECTION_TEST_TIMEOUT_MS=5000

# FTPS endpoint metadata and private SFTPGo status reader. The GCP Dev
# deployment uses ftps-dev.celesnity.com; this example mirrors that client
# endpoint. The hostname must not include ftps://, a port, or a path. The demo
# username/password are the external FTPS client credential and must match the
# deployed SFTPGo user. Status values remain backend-only; never commit real
# credentials to this file.
FTPS_PUBLIC_HOST=ftps-dev.celesnity.com
FTPS_PUBLIC_PORT=2121
FTPS_REMOTE_PATH=/incoming
FTPS_DEMO_USERNAME=ftps-demo-user
FTPS_DEMO_PASSWORD=replace-with-a-local-ftps-password
FTPS_SFTPGO_API_URL=http://sftpgo:8080
FTPS_STATUS_USERNAME=ftps-status-monitor
FTPS_STATUS_PASSWORD=replace-with-a-local-ftps-status-password
FTPS_STATUS_TIMEOUT_MS=3000

# Execution Orchestration (Phase 4). Compose uses Docker; Kubernetes creates one Job per run.
EXECUTION_TIMEOUT_MS=900000
EXECUTION_POLL_INTERVAL_MS=1000
EXECUTION_CLAIM_BATCH_SIZE=1
EXECUTION_MAX_ATTEMPTS=3
# Durable data-workflow reconciliation runs only in the worker process. A claim
# token fences dispatch, while each claimed row records its next reconciliation.
DATA_WORKFLOW_WORKER_POLL_INTERVAL_MS=1000
DATA_WORKFLOW_CLAIM_BATCH_SIZE=4
DATA_WORKFLOW_LEASE_MS=30000
DATA_WORKFLOW_RECONCILIATION_INTERVAL_MS=5000
SPARK_EXECUTION_BACKEND=docker
SPARK_SUBMIT_MASTER_URL=spark://spark-master:7077
SPARK_CONTAINER=celesnity-poc-spark-master-1
SPARK_SUBMIT_BIN=/opt/spark/bin/spark-submit
KUBERNETES_NAMESPACE=celesnity
SPARK_EXECUTION_IMAGE=celesnity/spark:3.5.7-iceberg-1.11.0
SPARK_JOB_SERVICE_ACCOUNT=celesnity-spark-job
SPARK_KUBERNETES_POLL_INTERVAL_MS=1000
SPARK_JOB_TTL_SECONDS=3600
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g
SPARK_EXECUTOR_CORES=1
SPARK_MAX_CORES=2

# Catalog Exploration (Phase 5) and Query Workbench (Phase 6) via Trino.
TRINO_USER=celesnity
# Empty locally: the Compose Trino runs unauthenticated over plain HTTP, and sending
# an Authorization header to a coordinator with no password authenticator is refused.
#
# Set in every deployed environment, where Trino requires a password over TLS. Node
# also has to trust the coordinator's certificate — see NODE_EXTRA_CA_CERTS in
# k8s/base/api.yaml — or the request fails on the handshake rather than on the
# credential, which looks like the wrong password.
TRINO_PASSWORD=
TRINO_CATALOG=iceberg
CATALOG_PREVIEW_MAX_ROWS=100
COLUMN_PROFILE_CACHE_TTL_MS=1800000
SQL_QUERY_TIMEOUT_MS=60000
SQL_MAX_RESULT_ROWS=1000

# Trusted-user PoC hardening: the API binds to loopback only by default.
# Change this only in an environment that adds its own authentication layer.
API_BIND_ADDRESS=127.0.0.1

# --- Rate limiting -----------------------------------------------------------
# Applies to mutating requests (POST/PUT/PATCH/DELETE) only. Machine routes use
# their dedicated workload-identity guard; no shared bearer token is accepted.
AGENT_WRITE_RATE_LIMIT=120
AGENT_WRITE_RATE_WINDOW_MS=60000

# How long a proposed (pending) action stays approvable before it expires.
# Default: 24 hours, matching AIP's own Logic-to-Automate proposal TTL.
PENDING_ACTION_TTL_MS=86400000

# Signs read-only chart share/embed tokens (POST /charts/:id/share,
# GET /charts/:id/embed). Replace in every deployed environment.
# Longest TTL a share token may be minted with. Default: 7 days.

# --- Outbox relay -----------------------------------------------------------
# Delivers staged integration events out of celesnity_app.outbox_events. Runs in
# the worker process only. Every value below has a working default, so this block
# is documentation rather than required configuration.
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100
# Attempts before a message is parked as FAILED rather than retried forever.
OUTBOX_RELAY_MAX_ATTEMPTS=10
# Retry delay doubles from the base up to the maximum.
OUTBOX_RELAY_BASE_BACKOFF_MS=1000
OUTBOX_RELAY_MAX_BACKOFF_MS=300000
# How long a PROCESSING claim may sit before it is treated as abandoned and
# retried. Must exceed the time one batch can take to deliver, or a healthy
# relay's own claims would be reclaimed underneath it and delivered twice.
OUTBOX_RELAY_CLAIM_TIMEOUT_MS=300000
OUTBOX_RELAY_MAINTENANCE_INTERVAL_MS=60000
# Consecutive full batches drained before yielding, so a large backlog clears
# quickly without monopolising the process.
OUTBOX_RELAY_MAX_CONSECUTIVE_DRAINS=10
# How long delivered messages are kept before being purged. Default: 7 days.
OUTBOX_RETENTION_MS=604800000

# --- Metadata crawler -------------------------------------------------------
# The scheduler creates durable runs; Redpanda delivers their run IDs directly
# to the worker. Recovery republishes only runs whose leases expired.
METADATA_CRAWLER_SCHEDULE_INTERVAL_MS=15000
METADATA_CRAWLER_RECOVERY_INTERVAL_MS=60000
METADATA_CRAWLER_CONSUMER_GROUP_ID=celesnity.metadata-crawler-worker.v1
REDPANDA_CONTROL_TOPIC=celesnity.streaming.control.v1
# Local Watch Source CDC. Set DATA_WORKFLOW_CDC_ENABLED=true only when the
# Infra cdc Compose profile is running; the worker then consumes metadata-only
# records from Redpanda and the API can reconcile Debezium connectors.
DATA_WORKFLOW_CDC_ENABLED=false
DATA_WORKFLOW_CDC_TOPIC=celesnity.data-workflow.cdc.v1
DATA_WORKFLOW_CDC_CONSUMER_GROUP_ID=celesnity.data-workflow-cdc.v1
DATA_WORKFLOW_CDC_SEAL_INTERVAL_MS=1000
DEBEZIUM_CONNECT_URL=http://debezium-connect:8083
DEBEZIUM_CONNECT_TIMEOUT_MS=5000
INTEGRATION_EVENT_PUBLISHER_BACKEND=redpanda

# Agent automation: dispatches Redpanda events to minder-agent's webhook trigger.
MINDER_AGENT_URL=http://minder-agent.internal/api/v2
AGENT_AUTOMATION_TOPICS=celesnity.streaming.control.v1
AGENT_AUTOMATION_CONSUMER_GROUP_ID=celesnity.agent-automation.v1
AGENT_AUTOMATION_SCHEDULE_INTERVAL_MS=15000
AGENT_AUTOMATION_SCHEDULE_BATCH_SIZE=20
AGENT_ACTIONS_POLICY_PATH=config/agent-actions.yaml
