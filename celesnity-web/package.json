{
  "name": "celesnity-web",
  "version": "0.1.0",
  "private": true,
  "description": "Celesnity data engineering workspace",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "api:generate": "openapi-typescript http://localhost:3001/api/docs-json -o src/infrastructure/api/generated/schema.d.ts",
    "build": "next build && node scripts/prepare-standalone-assets.mjs",
    "coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev",
    "local:env": "node scripts/local-environment.mjs --sync",
    "predev": "node scripts/local-environment.mjs --check",
    "predev:turbopack": "node scripts/local-environment.mjs --check",
    "format": "prettier --write --no-error-on-unmatched-pattern \"app/**/*.{ts,tsx,css}\" \"di/**/*.ts\" \"scripts/**/*.{ts,mts,mjs}\" \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{json,ts,mts,mjs}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"app/**/*.{ts,tsx,css}\" \"di/**/*.ts\" \"scripts/**/*.{ts,mts,mjs}\" \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{json,ts,mts,mjs}\"",
    "lint": "eslint .",
    "start": "node .next/standalone/server.js",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atomic-editor/editor": "0.6.2",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@evyweb/ioctopus": "1.4.1",
    "@google/genai": "2.26.0",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2",
    "@monaco-editor/react": "4.7.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@shadcn/react": "^0.3.1",
    "@xyflow/react": "12.11.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "fflate": "^0.8.2",
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "1.33.0",
    "monaco-editor": "0.56.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "pdfjs-dist": "4.10.38",
    "qrcode.react": "^4.2.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.12.3",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "thinking-orbs": "0.3.2",
    "three": "0.186.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-boundaries": "7.2.0",
    "fast-check": "4.10.2",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "shadcn": "4.19.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@google-cloud/storage": "8.0.1",
    "dompurify": "3.4.14",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "gaxios": "7.3.1",
    "retry-request": "9.0.1",
    "teeny-request": "11.0.1",
    "uuid": "11.1.1"
  }
}
