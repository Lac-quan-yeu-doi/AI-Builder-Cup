CORE_API_URL=http://localhost:3001/api/v1
AGENT_API_URL=http://localhost:8080/api/v2
WEB_ORIGIN=http://localhost:3000
CELESNITY_AUTH_MODE=local-development
# Workstations only. Run `npm run local:env` to generate and synchronize this
# value with celesnity-core/.env before starting Web.
LOCAL_DEV_AUTH_SIGNING_KEY=
IDENTITY_PLATFORM_PROJECT_ID=replace-with-gcp-project-id
IDENTITY_PLATFORM_API_KEY=replace-with-identity-platform-browser-api-key
IDENTITY_PLATFORM_AUTH_DOMAIN=replace-with-gcp-project-id.firebaseapp.com
# minder-agent (minder-serve) upstream for the server-side /api/agent proxy.
NEXT_PUBLIC_AGENT_API_URL=/api/agent
# Must match an agent name already registered via minder-agent's POST /agents.
NEXT_PUBLIC_CHAT_AGENT_NAME=chat-assistant
# The dedicated automation-workflow-editing agent — see
# minder-agent/agents/automation-workflow-editor.yaml.
NEXT_PUBLIC_AUTOMATION_WORKFLOW_CHAT_AGENT_NAME=automation-workflow-editor
# The dedicated skill-authoring agent — see minder-agent/agents/skill-creator.yaml.
NEXT_PUBLIC_SKILL_CHAT_AGENT_NAME=skill-creator
# The dedicated Plant Model exploration agent — see
# minder-agent/agents/plant-model-assistant.yaml.
NEXT_PUBLIC_PLANT_MODEL_CHAT_AGENT_NAME=plant-model-assistant
